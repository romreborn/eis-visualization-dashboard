# Development Environment Variables
# Copy this file to .env and modify as needed

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Authentication
BETTER_AUTH_SECRET=your_secret_key_here_please_change_this_in_production
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ASP.NET Backend API Configuration
# Replace with your actual ASP.NET backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# CORS Configuration
# Add your frontend URLs here (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature Flags
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_LOGGING=true

# Optional: Custom headers for API requests
# API_CUSTOM_HEADER_NAME=X-Custom-Header
# API_CUSTOM_HEADER_VALUE=your-value